# Existing public client configuration (never use an administrative key here).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native Android Maps key: Android package + certificate SHA-1 restrictions,
# and API restriction to Maps SDK for Android only. No Map ID is used.
# Put the real value in .env.local, never in this example or in app.json.
GOOGLE_MAPS_ANDROID_API_KEY=
